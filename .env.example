NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# HEADLESS is no longer used - the browser always runs headed now (headless Chromium is easy for
# Naukri to fingerprint). Left here as a no-op in case you had it set.
HEADLESS=false

# Optional: max real applications per calendar day, kept well under Naukri's own ~50/day cap.
DAILY_APPLY_LIMIT=20

# Optional: point the persistent browser profile somewhere other than data/browser_profile.
# CHROME_USER_DATA_DIR=

# Optional: "chrome" to use your real installed Google Chrome instead of Playwright's bundled
# Chromium (closer to a genuine daily-driver fingerprint). Leave unset to use bundled Chromium.
# CHROME_CHANNEL=chrome
